<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Help System Views -->
    
    <!-- Help Sidebar View -->
    <record id="view_help_sidebar" model="ir.ui.view">
        <field name="name">Help Sidebar</field>
        <field name="model">ir.help</field>
        <field name="arch" type="xml">
            <t t-call="web.base_layout">
                <t t-set="title">UniERP Help System</t-set>
                <t t-set="head">
                    <title>UniERP Help System</title>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                    <link rel="stylesheet" href="/web/static/src/scss/help_system.css"/>
                    <script type="text/javascript" src="/web/static/src/js/help_sidebar.js"></script>
                </t-set>
                <t t-set="main">
                    <div class="o_content">
                        <div class="o_help_sidebar" id="help_sidebar"></div>
                    </div>
                </t-set>
            </t>
        </field>
    </record>
    
